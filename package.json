{
  "name": "stm-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.conf.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"contracts/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:desktop-integration": "vitest run --config e2e-tests/vitest.config.ts",
    "verify:ui-contract": "node --import tsx scripts/verify-ui-contract.ts",
    "verify:phase-two-foundation": "node scripts/verify-phase-two-foundation.mjs",
    "verify:phase-three-core": "node scripts/verify-phase-three-core.mjs",
    "verify:phase-four-desktop": "pnpm verify:ui-contract && pnpm typecheck && pnpm test && pnpm test:desktop-integration && cargo test -p stm-core application::service && cargo test -p stm-desktop && pnpm tauri:build",
    "lock:ui-contract": "node --import tsx scripts/verify-ui-contract.ts --write-lock"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.11.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.14.0"
}
